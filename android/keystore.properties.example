# Copy to android/keystore.properties (gitignored) and point at your upload keystore.
# Play Console → Cortex Developments → Rootweave uses this as the *upload* key.
# Digital Asset Links must use the *App signing* SHA-256 from Play Console, not this key.
storeFile=upload-keystore.jks
storePassword=replace-me
keyAlias=rootweave
keyPassword=replace-me
